# ==============================================================================
# DecisionFlow AI - Snowflake & Application Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env with real credentials to version control.
# ==============================================================================

# Snowflake Connection Settings
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DECISIONFLOW_DB
SNOWFLAKE_SCHEMA=PUBLIC

# Snowflake Cortex AI Configuration
CORTEX_MODEL=openai-gpt-5
DOCUMENTS_TABLE=DOCUMENTS

# API Server Settings
HOST=0.0.0.0
PORT=8000
